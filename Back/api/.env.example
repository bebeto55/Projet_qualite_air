# Copier ce fichier en .env et compléter.

# ── Supabase (lecture de la table `mesures`) ──
SUPABASE_URL=https://wynjcciiprpxtkvjaurm.supabase.co
# Si vide, le token est lu dans Back/secrets.toml (supabase_tok)
SUPABASE_TOKEN=

# ── Sécurité ──
# Générer une valeur aléatoire longue (ex: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_EXPIRE_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comptes supplémentaires : login:motdepasse:Nom:Rôle[:admin];...
USERS_EXTRA=

# ── Cache (secondes) ──
CACHE_TTL_MEASURES=120
CACHE_TTL_PREDICTIONS=1800

# ── Alertes e-mail (ex: Gmail avec mot de passe d'application) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ── Power BI Embedded (optionnel) ──
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
